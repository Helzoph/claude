# All three environment tiers share this one command entrypoint and determine their identity from the directory name.
#
# Why the criterion is the directory name, not the branch name or an ENV switch:
# Docker Compose derives the project name from the directory name by default, and
# container and volume names carry that prefix, so the directory name is already
# the factual criterion for "which data set this command will touch". The guard
# hook uses it too. Introducing a third source of truth would allow states where
# "two places say this is UAT and one says prod". Branches in particular must not
# be used: a checkout can change the branch, but not the directory.
#
# Direct consequence: the UAT directory must be named __UAT_DIR__. A different name
# does not raise an error; it just quietly falls back to the dev config — exactly
# what `up` below is meant to prevent, so _guard-dev turns it into an immediate failure.
#
# Placeholders are filled in by the env-tiers/setup-tiers skill:
#   __PROD_DIR__      the prod directory name
#   __UAT_DIR__       the UAT directory name
#   __PROD_OVERRIDE__ the compose override file name prod must always include

project := file_name(justfile_directory())

# Three tiers: __PROD_DIR__=prod, __UAT_DIR__=UAT, anything else=worktree dev copy (no containers)
layer := if project == "__PROD_DIR__" { "prod" } else if project == "__UAT_DIR__" { "uat" } else { "dev" }

# Prod always includes the override. Putting it in a variable instead of relying on
# people to remember it on the command line is the main reason this file exists:
# `up` without the override does not raise an error; it silently brings the source bind mount back.
compose := if layer == "prod" {
    "docker compose -f docker-compose.yml -f __PROD_OVERRIDE__"
} else {
    "docker compose"
}

# Prod's source is baked into the image, so without --build nothing is updated —
# yet the containers still start and the page still opens, just running the
# previous version of the code. UAT uses a bind mount and does not need it.
build_flag := if layer == "prod" { "--build" } else { "" }

url := "http://" + project + ".localhost"

_default:
    @just --list --unsorted

# What this tier is, which files it uses, and its address. Run this first when unsure which tier you are in
[group('env')]
env:
    @echo "dir     {{ project }}"
    @echo "tier    {{ layer }}"
    @echo "compose {{ compose }}"
    @echo "url     {{ if layer == 'dev' { '(worktree, no containers)' } else { url } }}"

# Starting containers in a worktree is pointless: COMPOSE_PROJECT_NAME becomes the
# worktree's directory name, so the containers land on a hostname nobody visits,
# and the volumes are not shared with UAT/prod — they start, but are useless.
# Rather than silently start a set of orphan containers, stop here.
_guard-dev:
    @if [ "{{ layer }}" = "dev" ]; then \
        echo "This is a worktree ({{ project }}); no containers are started here." >&2; \
        echo "  Change code here, verify in __UAT_DIR__/, ship in __PROD_DIR__/." >&2; \
        exit 1; \
    fi

# Start. Prod automatically includes the override and --build; UAT uses the base config
[group('containers')]
up *ARGS: _guard-dev
    {{ compose }} up -d {{ build_flag }} {{ ARGS }}
    @echo ""
    @echo "→ {{ url }}"

# Stop. Deliberately does not offer -v: that would delete prod's data volume. To wipe data, go to UAT and type the full command by hand
[group('containers')]
down:
    {{ compose }} down

# Restart. Use when something that does not require rebuilding the image changed, such as .env
[group('containers')]
restart *ARGS: _guard-dev
    {{ compose }} restart {{ ARGS }}
    @echo ""
    @echo "→ {{ url }}"

# Container status
[group('containers')]
ps:
    @{{ compose }} ps

# Follow logs. No arguments means all services; `just logs <service>` also works
[group('containers')]
logs *ARGS:
    {{ compose }} logs -f {{ ARGS }}

# TODO(setup-tiers): replace with this project's actual gate commands (type check + tests + build).
# Run this before merging into UAT.
[group('checks')]
check:
    @echo "TODO: fill in this project's check commands" && exit 1
