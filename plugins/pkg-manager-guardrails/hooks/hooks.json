{
  "description": "Blocks direct node_modules/.bin invocations and direct manifest/lockfile edits, steering toward package-manager CLIs instead.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-node-modules-bin.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-manifest-lock-edit.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
