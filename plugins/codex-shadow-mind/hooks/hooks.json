{
  "description": "Runs read-only shadow reviewers alongside the main Codex agent: a heartbeat after edits dispatches them in the background, and an end-of-turn gate replays anything they found.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/scripts/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash|exec_command|shell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/scripts/heartbeat.sh\"",
            "timeout": 30,
            "statusMessage": "Shadow minds watching",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/scripts/collect-reports.sh\"",
            "timeout": 60,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/scripts/session-end.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
