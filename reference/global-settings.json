  "autoMode": {
    "allow": [
      "$defaults",
      "Run any read-only MCP tool",
      "Fetch public documentation and API schemas via HTTP GET",
      "Execute targeted rm within the project when intent is clear from conversation context"
    ],
    "soft_deny": [
      "$defaults",
      "Confirm before deploy, publish, or release commands",
      "Confirm before modifying environment variable files (.env*)",
      "Confirm before database migrations or seed scripts",
      "Confirm before docker build, docker run, or docker compose up/down",
      "Confirm before HTTP write requests (POST, PUT, PATCH, DELETE) to external services",
      "Confirm before modifying CI/CD pipeline configurations"
    ],
    "hard_deny": [
      "$defaults",
      "Never install global system packages",
      "Never modify files outside the working directory tree",
      "Never send project data to untrusted external services",
      "Never disable or bypass git hooks, linters, or security checks"
    ],
    "environment": [
      "$defaults",
      "Local macOS development environment, no production access",
      "Package managers: pnpm, bun, uv",
      "Source control: GitHub"
    ]
  },
  "voiceEnabled": true,
  "autoMode.classifyAllShell": false,
  "agentPushNotifEnabled": true
